---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import Publications from '../components/Publications.astro';
import References from '../components/References.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Stats />
    <Skills />
    <Experience />
    <Projects />
    <Publications />
    <Education />
    <References />
    <Contact />
  </main>

  <footer>
    <div class="footer-inner">
      <span class="footer-logo grad-text">BN.</span>
      <p>Designed &amp; engineered by <strong>Bharathwaj Nedoumaran</strong> · 2026</p>
      <div class="footer-links">
        <a href="https://linkedin.com/in/bharathwaj-nedoumaran" target="_blank" rel="noopener">LinkedIn</a>
        <span class="sep">·</span>
        <a href="https://github.com/Bharath-Maran" target="_blank" rel="noopener">GitHub</a>
        <span class="sep">·</span>
        <a href="mailto:bharathwaj.nedou@gmail.com">Email</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
    background: var(--bg-0);
  }
  .footer-inner {
    max-width: 1120px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-logo { font-size: 1.1rem; font-weight: 900; letter-spacing: -.5px; }
  footer p { font-size: .78rem; color: var(--txt-3); }
  footer strong { color: var(--txt-2); font-weight: 600; }
  .footer-links { display: flex; align-items: center; gap: .5rem; }
  .footer-links a {
    font-size: .78rem; color: var(--txt-3);
    transition: color .2s;
  }
  .footer-links a:hover { color: var(--ac2); }
  .sep { color: var(--txt-3); }
</style>
