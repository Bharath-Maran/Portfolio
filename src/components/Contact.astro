---
import { person } from '../data/resume';
---

<section id="contact" class="contact-sec">
  <!-- Full-bleed aurora bg -->
  <div class="contact-aurora">
    <div class="ca-ring ca-1"></div>
    <div class="ca-ring ca-2"></div>
  </div>

  <div class="section-wrap">
    <div class="contact-inner" data-reveal="scale">
      <!-- Header -->
      <div class="contact-hd">
        <span class="section-lbl">Let's Connect</span>
        <h2 class="contact-title">
          Got a project<br/>
          in mind? <span class="grad-text">Let's talk.</span>
        </h2>
        <p class="contact-sub">
          I'm open to full-time roles, research collaborations, freelance projects,
          or just a great conversation about tech and ideas.
        </p>
      </div>

      <!-- Link grid -->
      <div class="contact-links">
        <a href={`mailto:${person.email}`} class="clink clink-primary">
          <span class="clink-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </span>
          <span class="clink-text">
            <span class="clink-lbl">Email me</span>
            <span class="clink-val">{person.email}</span>
          </span>
          <svg class="clink-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>

        <a href={person.linkedin} target="_blank" rel="noopener" class="clink">
          <span class="clink-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </span>
          <span class="clink-text">
            <span class="clink-lbl">LinkedIn</span>
            <span class="clink-val">bharathwaj-nedoumaran</span>
          </span>
          <svg class="clink-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>

        <a href={person.github} target="_blank" rel="noopener" class="clink">
          <span class="clink-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </span>
          <span class="clink-text">
            <span class="clink-lbl">GitHub</span>
            <span class="clink-val">Bharath-Maran</span>
          </span>
          <svg class="clink-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>

        <a href={`tel:${person.phone.replace(/\s/g,'')}`} class="clink">
          <span class="clink-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.11 19.79 19.79 0 01.01.45 2 2 0 012.01 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-.64a2 2 0 012.11.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </span>
          <span class="clink-text">
            <span class="clink-lbl">Call me</span>
            <span class="clink-val">{person.phone}</span>
          </span>
          <svg class="clink-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-sec {
    padding: 6rem 0;
    position: relative; overflow: hidden;
    background: var(--bg-1);
  }

  /* Aurora bg */
  .contact-aurora { position: absolute; inset: 0; pointer-events: none; }
  .ca-ring { position: absolute; border-radius: 50%; filter: blur(100px); }
  .ca-1 {
    width: 500px; height: 500px;
    background: rgba(249,115,22,.15);
    top: -20%; right: -10%;
    animation: drift 12s ease-in-out infinite;
  }
  .ca-2 {
    width: 400px; height: 400px;
    background: rgba(255,107,107,.1);
    bottom: -15%; left: -5%;
    animation: drift 10s ease-in-out infinite reverse;
  }

  .contact-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 4rem; align-items: center;
  }
  @media (max-width: 768px) {
    .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* Header */
  .contact-hd { }
  .contact-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 900; letter-spacing: -2px; line-height: 1.1;
    color: var(--txt-1); margin: .6rem 0 1rem;
  }
  .contact-sub { font-size: .9rem; color: var(--txt-2); line-height: 1.75; }

  /* Links */
  .contact-links { display: flex; flex-direction: column; gap: .75rem; }

  .clink {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 14px; color: var(--txt-2);
    transition: all .25s; position: relative; overflow: hidden;
  }
  .clink::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--grad);
    transform: scaleY(0); transform-origin: bottom;
    transition: transform .3s;
  }
  .clink:hover { border-color: var(--border-h); color: var(--txt-1); transform: translateX(6px); }
  .clink:hover::before { transform: scaleY(1); }

  /* Primary CTA */
  .clink-primary {
    background: var(--grad);
    border-color: transparent;
    color: #fff;
  }
  .clink-primary::before { background: rgba(255,255,255,.25); }
  .clink-primary:hover { color: #fff; }
  .clink-primary .clink-lbl { color: rgba(255,255,255,.7); }
  .clink-primary .clink-val { color: #fff; }

  .clink-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.12); border-radius: 10px;
  }
  .clink-primary:not(:hover) .clink-icon { background: rgba(255,255,255,.18); }
  .clink:not(.clink-primary) .clink-icon {
    background: var(--tag-bg); border: 1px solid var(--border);
  }

  .clink-text { flex: 1; }
  .clink-lbl { display: block; font-size: .7rem; font-weight: 600; color: var(--txt-3); text-transform: uppercase; letter-spacing: 1px; }
  .clink-val { display: block; font-size: .875rem; font-weight: 700; margin-top: .1rem; }
  .clink-primary .clink-lbl { color: rgba(255,255,255,.65); }

  .clink-arrow { color: var(--txt-3); flex-shrink: 0; transition: transform .25s; }
  .clink:hover .clink-arrow { transform: rotate(45deg); color: var(--ac2); }
  .clink-primary .clink-arrow { color: rgba(255,255,255,.7); }
  .clink-primary:hover .clink-arrow { color: #fff; }
</style>
