---
import { experience } from '../data/resume';
---

<section id="experience" class="exp-sec">
  <div class="section-wrap">
    <div class="section-hd">
      <span class="section-lbl">Work History</span>
      <h2 class="section-title">Professional <span class="grad-text">Experience</span></h2>
    </div>

    <div class="exp-list-wrap">
      {experience.map((exp, i) => (
        <div class="exp-card" data-reveal="left" style={`--delay: ${i * .15}s`}>
          <!-- Left accent bar -->
          <div class="exp-accent"></div>

          <div class="exp-body">
            <!-- Top row -->
            <div class="exp-top">
              <div class="exp-co-row">
                <div class="logo-box">
                  <img
                    src={exp.logo}
                    alt={exp.company}
                    class="co-logo"
                    width="48" height="48" loading="lazy"
                    onerror={`this.style.display='none'; this.nextElementSibling.style.display='flex'`}
                  />
                  <div class="co-logo-fb" style="display:none;">{exp.company[0]}</div>
                </div>
                <div>
                  <div class="exp-role">{exp.role}</div>
                  <div class="exp-co">{exp.company}</div>
                </div>
              </div>
              <div class="exp-meta">
                <span class="exp-period">{exp.period}</span>
                <span class="exp-loc">📍 {exp.location}</span>
              </div>
            </div>

            <!-- Divider -->
            <div class="exp-divider"></div>

            <!-- Bullets -->
            <ul class="exp-bullets">
              {exp.bullets.map(b => (
                <li>
                  <span class="bullet-dot"></span>
                  <span set:html={b} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-sec { padding: 5rem 0; background: var(--bg-1); }

  .exp-list-wrap { display: flex; flex-direction: column; gap: 1.25rem; }

  /* Card */
  .exp-card {
    display: flex; position: relative;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 20px; overflow: hidden;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .exp-card:hover {
    border-color: var(--border-h);
    transform: translateX(6px);
    box-shadow: -6px 0 32px var(--glow-h), var(--shadow);
  }

  /* Left gradient accent bar */
  .exp-accent {
    width: 4px; flex-shrink: 0;
    background: var(--grad);
    transition: width .3s;
  }
  .exp-card:hover .exp-accent { width: 6px; }

  .exp-body { flex: 1; padding: 1.5rem 1.75rem; }

  /* Top row */
  .exp-top {
    display: flex; justify-content: space-between;
    align-items: flex-start; flex-wrap: wrap; gap: 1rem;
    margin-bottom: 1rem;
  }
  .exp-co-row { display: flex; align-items: center; gap: .9rem; }

  /* Logo */
  .logo-box { flex-shrink: 0; }
  .co-logo {
    width: 48px; height: 48px; border-radius: 12px;
    background: #fff; border: 1px solid rgba(0,0,0,.08);
    object-fit: contain; padding: 5px;
  }
  .co-logo-fb {
    width: 48px; height: 48px; border-radius: 12px;
    background: var(--grad);
    align-items: center; justify-content: center;
    font-size: 1.3rem; font-weight: 900; color: #fff;
  }

  .exp-role { font-size: 1.05rem; font-weight: 800; color: var(--txt-1); letter-spacing: -.3px; }
  .exp-co   { font-size: .875rem; color: var(--ac1); font-weight: 600; margin-top: .1rem; }

  .exp-meta { display: flex; flex-direction: column; align-items: flex-end; gap: .25rem; }
  .exp-period {
    font-family: 'JetBrains Mono', monospace;
    font-size: .8rem; font-weight: 700;
    padding: .3rem .85rem;
    background: var(--tag-bg); border: 1px solid var(--border);
    border-radius: 8px; color: var(--tag-txt);
    white-space: nowrap;
    letter-spacing: .02em;
  }
  .exp-loc { font-size: .8rem; color: var(--txt-3); }

  /* Divider */
  .exp-divider {
    height: 1px; background: var(--border); margin-bottom: 1rem;
  }

  /* Bullets */
  .exp-bullets { display: flex; flex-direction: column; gap: .6rem; }
  .exp-bullets li {
    display: flex; gap: .75rem; align-items: flex-start;
    font-size: .875rem; color: var(--txt-2); line-height: 1.7;
  }
  .bullet-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--grad); flex-shrink: 0; margin-top: .5rem;
    box-shadow: 0 0 6px var(--ac2);
  }
  .exp-bullets :global(strong) { color: var(--txt-1); font-weight: 700; }

  /* Highlight impact numbers */
  .exp-bullets :global(strong):has-text('%'),
  .exp-bullets :global(strong) {
    background: var(--tag-bg);
    border-radius: 4px;
    padding: 0 3px;
  }

  @media (max-width: 580px) {
    .exp-top { flex-direction: column; }
    .exp-meta { align-items: flex-start; }
  }
</style>
