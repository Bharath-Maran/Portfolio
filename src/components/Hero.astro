---
import { person } from '../data/resume';
---

<section id="hero" class="hero">
  <!-- Particle canvas -->
  <canvas id="hero-canvas"></canvas>

  <!-- Soft ambient glow blobs (no border-radius → no hard circular edge) -->
  <div class="glow glow-1"></div>
  <div class="glow glow-2"></div>
  <div class="glow glow-3"></div>

  <!-- Grid overlay -->
  <div class="hero-grid"></div>

  <div class="hero-inner">

    <!-- Availability badge -->
    <div class="hero-badge" style="animation: fadeUp .5s ease both;">
      <div class="badge-avail">
        <span class="dot"></span>
        <span>Open to Work</span>
      </div>
    </div>

    <!-- Name block -->
    <h1 class="hero-name" style="animation: fadeUp .5s ease .1s both;">
      <span class="name-first grad-text">{person.name.split(' ')[0]}</span>
      <span class="name-last">{person.name.split(' ')[1]}</span>
    </h1>

    <!-- Typewriter subtitle -->
    <div class="hero-subtitle" style="animation: fadeUp .5s ease .2s both;">
      <span class="sub-static">I build </span>
      <span class="typewriter" id="typewriter"></span>
      <span class="cursor-blink">_</span>
    </div>

    <!-- Trait pills -->
    <div class="hero-traits" style="animation: fadeUp .5s ease .3s both;">
      {person.traits.map((t, i) => (
        <span class="trait-pill" style={`animation-delay: ${i * .06}s`}>{t}</span>
      ))}
    </div>

    <!-- CTA row -->
    <div class="hero-cta" style="animation: fadeUp .5s ease .4s both;">
      <a href="#projects" class="btn-grad">
        View My Work
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href={`mailto:${person.email}`} class="btn-ghost">Get In Touch</a>
    </div>

    <!-- Download row -->
    <div class="dl-row" style="animation: fadeUp .5s ease .45s both;">

      <a href="/Bharathwaj-Resume.pdf" download class="dl-btn dl-resume">
        <div class="dl-shimmer"></div>
        <!-- Icon -->
        <div class="dl-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="8" y1="13" x2="16" y2="13"/>
            <line x1="8" y1="17" x2="13" y2="17"/>
          </svg>
        </div>
        <!-- Info -->
        <div class="dl-info">
          <span class="dl-name">Resume</span>
          <span class="dl-meta">Single-page · PDF</span>
        </div>
        <!-- CTA pill -->
        <div class="dl-cta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" class="dl-arrow">
            <line x1="12" y1="4" x2="12" y2="20"/>
            <polyline points="18 14 12 20 6 14"/>
          </svg>
          <span>Download</span>
        </div>
      </a>

      <a href="/Bharathwaj-CV.pdf" download class="dl-btn dl-cv">
        <div class="dl-shimmer"></div>
        <!-- Icon -->
        <div class="dl-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="8" y1="13" x2="16" y2="13"/>
            <line x1="8" y1="17" x2="16" y2="17"/>
          </svg>
        </div>
        <!-- Info -->
        <div class="dl-info">
          <span class="dl-name">Curriculum Vitae</span>
          <span class="dl-meta">Full document · PDF</span>
        </div>
        <!-- CTA pill -->
        <div class="dl-cta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" class="dl-arrow">
            <line x1="12" y1="4" x2="12" y2="20"/>
            <polyline points="18 14 12 20 6 14"/>
          </svg>
          <span>Download</span>
        </div>
      </a>

    </div>

    <!-- Socials -->
    <div class="hero-socials" style="animation: fadeUp .5s ease .55s both;">
      <a href={person.linkedin} target="_blank" rel="noopener" class="soc" title="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href={person.github} target="_blank" rel="noopener" class="soc" title="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href={`mailto:${person.email}`} class="soc" title="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </a>
      <a href={`tel:${person.phone.replace(/\s/g,'')}`} class="soc" title="Phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.11 19.79 19.79 0 01.01.45 2 2 0 012.01 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-.64a2 2 0 012.11.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="scroll-cue" style="animation: fadeUp .5s ease .8s both;">
    <svg class="cue-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
    padding: 6rem 2rem 5rem;
  }

  /* Particle canvas */
  #hero-canvas {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%;
    pointer-events: none;
  }

  /* Grid dots */
  .hero-grid {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background-image: radial-gradient(circle, var(--border) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000 20%, transparent 100%);
    opacity: .6;
  }

  /* Ambient glow blobs — NO border-radius, so no hard circular clipping edge */
  .glow {
    position: absolute; pointer-events: none; z-index: 0;
    animation: drift 12s ease-in-out infinite;
  }
  .glow-1 {
    width: 900px; height: 700px;
    background: radial-gradient(ellipse at center,
      rgba(249,115,22,.22) 0%,
      rgba(249,115,22,.07) 40%,
      transparent 70%);
    top: -20%; left: -18%;
    animation-duration: 15s;
  }
  .glow-2 {
    width: 700px; height: 600px;
    background: radial-gradient(ellipse at center,
      rgba(255,107,107,.18) 0%,
      rgba(255,107,107,.05) 40%,
      transparent 70%);
    bottom: -15%; right: -12%;
    animation-duration: 11s; animation-delay: -4s;
  }
  .glow-3 {
    width: 500px; height: 500px;
    background: radial-gradient(ellipse at center,
      rgba(251,191,36,.15) 0%,
      rgba(251,191,36,.04) 40%,
      transparent 70%);
    top: 35%; right: 8%;
    animation-duration: 9s; animation-delay: -7s;
  }

  /* Content */
  .hero-inner { position: relative; z-index: 2; text-align: left; max-width: 820px; }

  /* Badge — two-segment pill */
  .hero-badge {
    display: inline-flex; align-items: stretch;
    border: 1px solid rgba(34,197,94,.3);
    border-radius: 100px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    margin-bottom: 2rem;
    font-size: .75rem; font-weight: 600;
  }
  .badge-avail {
    display: flex; align-items: center; gap: .45rem;
    padding: .42rem 1rem;
    background: rgba(34,197,94,.1);
    color: #22c55e;
  }
  .dot {
    width: 7px; height: 7px; background: #22c55e; border-radius: 50%;
    animation: blink 2s ease infinite; flex-shrink: 0;
    box-shadow: 0 0 6px #22c55e;
  }

  /* Name */
  .hero-name {
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 900;
    letter-spacing: -4px;
    line-height: 1.02;
    margin-bottom: 1.2rem;
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .name-first { display: block; }
  .name-last {
    display: block;
    color: var(--txt-1);
  }

  /* Typewriter subtitle */
  .hero-subtitle {
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    color: var(--txt-2);
    margin-bottom: 2rem;
    height: 2em;
    display: flex; align-items: center; justify-content: flex-start; gap: .2em;
  }
  .sub-static { color: var(--txt-2); }
  .typewriter { color: var(--ac2); font-weight: 700; min-width: 2ch; }
  .cursor-blink {
    color: var(--ac1); font-weight: 100;
    animation: blink 1s step-end infinite;
  }

  /* Traits */
  .hero-traits {
    display: flex; flex-wrap: wrap; gap: .45rem; justify-content: flex-start;
    margin-bottom: 2.5rem;
  }
  .trait-pill {
    padding: .28rem .8rem;
    background: var(--tag-bg); border: 1px solid var(--border);
    border-radius: 50px; font-size: .75rem; color: var(--txt-2); font-weight: 500;
    transition: all .2s;
    animation: fadeUp .4s ease both;
  }
  .trait-pill:hover {
    border-color: var(--ac2); color: var(--ac2);
    background: rgba(255,107,107,.1);
    transform: translateY(-2px);
  }

  /* CTA */
  .hero-cta { display: flex; gap: 1rem; justify-content: flex-start; flex-wrap: wrap; margin-bottom: 0; }

  /* ── Download buttons ── */
  .dl-row {
    display: flex; gap: .75rem; flex-wrap: wrap;
    align-items: stretch;
    margin-top: 1.25rem;
  }

  .dl-btn {
    position: relative; overflow: hidden;
    display: flex; align-items: center; gap: .9rem;
    padding: .75rem 1rem .75rem .85rem;
    border-radius: 16px;
    text-decoration: none; color: inherit;
    /* Equal width: grow from 0 so both share space evenly */
    flex: 1 1 0;
    min-width: 200px;
    /* Gradient border via background-clip trick */
    background:
      linear-gradient(var(--card), var(--card)) padding-box,
      var(--grad) border-box;
    border: 1.5px solid transparent;
    transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
    cursor: pointer;
  }
  .dl-btn:hover {
    transform: translateY(-4px);
  }
  .dl-resume:hover { box-shadow: 0 12px 36px rgba(249,115,22,.22), 0 0 0 1px rgba(249,115,22,.4); }
  .dl-cv:hover     { box-shadow: 0 12px 36px rgba(255,107,107,.22), 0 0 0 1px rgba(255,107,107,.4); }

  /* Shimmer sweep */
  .dl-shimmer {
    position: absolute; top: 0; left: -100%; width: 55%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.07), transparent);
    transform: skewX(-18deg);
    transition: left .55s ease;
    pointer-events: none;
  }
  .dl-btn:hover .dl-shimmer { left: 160%; }

  /* Document icon */
  .dl-icon {
    width: 44px; height: 44px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    border-radius: 12px;
    transition: transform .3s cubic-bezier(.34,1.56,.64,1);
  }
  .dl-resume .dl-icon { background: rgba(249,115,22,.15); color: var(--ac1); border: 1px solid rgba(249,115,22,.3); }
  .dl-cv     .dl-icon { background: rgba(255,107,107,.15); color: var(--ac2); border: 1px solid rgba(255,107,107,.3); }
  .dl-btn:hover .dl-icon { transform: scale(1.1) rotate(-6deg); }

  /* Info text */
  .dl-info { flex: 1; min-width: 0; }
  .dl-name {
    display: block; font-size: .9rem; font-weight: 800;
    color: var(--txt-1); letter-spacing: -.2px;
  }
  .dl-meta {
    display: block; font-size: .63rem; color: var(--txt-3);
    margin-top: .08rem; letter-spacing: .03em;
    font-family: 'JetBrains Mono', monospace;
  }

  /* "Download" CTA pill */
  .dl-cta {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .32rem .75rem;
    border-radius: 50px;
    font-size: .7rem; font-weight: 800;
    white-space: nowrap;
    transition: gap .25s, padding .25s;
    flex-shrink: 0;
  }
  .dl-resume .dl-cta { background: rgba(249,115,22,.15); color: var(--ac1); border: 1px solid rgba(249,115,22,.3); }
  .dl-cv     .dl-cta { background: rgba(255,107,107,.15); color: var(--ac2); border: 1px solid rgba(255,107,107,.3); }
  .dl-resume:hover .dl-cta { background: rgba(249,115,22,.25); border-color: rgba(249,115,22,.55); }
  .dl-cv:hover     .dl-cta { background: rgba(255,107,107,.25); border-color: rgba(255,107,107,.55); }

  /* Bouncing download arrow inside cta pill */
  .dl-arrow { transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
  .dl-btn:hover .dl-arrow { transform: translateY(3px); }

  /* Socials */
  .hero-socials { display: flex; gap: .65rem; justify-content: flex-start; margin-top: 2rem; }
  .soc {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; color: var(--txt-2);
    transition: all .2s;
  }
  .soc:hover {
    border-color: var(--ac2); color: var(--ac2);
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 8px 20px rgba(255,107,107,.25);
  }

  /* Scroll cue */
  .scroll-cue {
    position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    color: var(--txt-3);
  }
  .cue-arrow { animation: chevron-bounce 1.5s ease infinite; }
</style>

<script is:inline>
(function () {
  /* ── Particle canvas ── */
  const canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, particles = [];
  const COUNT = 60;
  const COLORS = ['249,115,22', '255,107,107', '251,191,36'];

  function resize() {
    W = canvas.width  = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  function Particle() {
    this.x = Math.random() * W;
    this.y = Math.random() * H;
    this.r = Math.random() * 1.5 + .5;
    this.vx = (Math.random() - .5) * .35;
    this.vy = (Math.random() - .5) * .35;
    this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
    this.alpha = Math.random() * .55 + .1;
  }
  Particle.prototype.update = function () {
    this.x += this.vx; this.y += this.vy;
    if (this.x < 0) this.x = W; if (this.x > W) this.x = 0;
    if (this.y < 0) this.y = H; if (this.y > H) this.y = 0;
  };

  for (let i = 0; i < COUNT; i++) particles.push(new Particle());

  function draw() {
    ctx.clearRect(0, 0, W, H);
    /* Draw connections */
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 120) {
          ctx.beginPath();
          ctx.strokeStyle = `rgba(${particles[i].color},${(1 - dist/120) * .18})`;
          ctx.lineWidth = .7;
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }
    /* Draw dots */
    particles.forEach(p => {
      p.update();
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
      ctx.fillStyle = `rgba(${p.color},${p.alpha})`;
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  draw();

  /* ── Typewriter ── */
  const words = [
    'scalable APIs.',
    'full-stack apps.',
    'ML pipelines.',
    'great products.'
  ];
  const el = document.getElementById('typewriter');
  if (!el) return;

  let wi = 0, ci = 0, deleting = false;
  function type() {
    const word = words[wi];
    if (!deleting) {
      el.textContent = word.slice(0, ++ci);
      if (ci === word.length) { deleting = true; setTimeout(type, 1800); return; }
    } else {
      el.textContent = word.slice(0, --ci);
      if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
    }
    setTimeout(type, deleting ? 55 : 85);
  }
  setTimeout(type, 800);
})();
</script>
